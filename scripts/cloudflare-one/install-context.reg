Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\SOFTWARE\Classes\com.cloudflare.warp]
@="URL:com.cloudflare.warp Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\SOFTWARE\Classes\com.cloudflare.warp\DefaultIcon]
@="$cfdir\\Cloudflare WARP.exe,1"

[HKEY_CURRENT_USER\SOFTWARE\Classes\com.cloudflare.warp\shell]
[HKEY_CURRENT_USER\SOFTWARE\Classes\com.cloudflare.warp\shell\open]
[HKEY_CURRENT_USER\SOFTWARE\Classes\com.cloudflare.warp\shell\open\command]
@="\"$cfdir\\Cloudflare WARP.exe\" \"%1\""
