Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\SOFTWARE\Classes\tailscale]
@="URL:Tailscale Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\SOFTWARE\Classes\tailscale\DefaultIcon]
@="$tsdir\\tailscale-ipn.exe,1"

[HKEY_CURRENT_USER\SOFTWARE\Classes\tailscale\shell]
[HKEY_CURRENT_USER\SOFTWARE\Classes\tailscale\shell\open]
[HKEY_CURRENT_USER\SOFTWARE\Classes\tailscale\shell\open\command]
@="\"$tsdir\\tailscale-ipn.exe\" /url \"%1\""
